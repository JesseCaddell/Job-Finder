# Copy to .env for local dev (`npm run dev`), and add the same keys in
# Netlify → Site configuration → Environment variables for production.
# Never commit .env — it's gitignored.

# ── Required for shared mode (Supabase) ───────────────────────
# Supabase dashboard → Project Settings → API
# Leave both blank to run in local mode (localStorage, passcode gate).
# e.g. https://abcdefgh.supabase.co
SUPABASE_URL=
SUPABASE_ANON_KEY=

# ── Required for AI scoring + resume improvements ─────────────
# console.anthropic.com → API Keys. Billed separately from Claude.ai.
ANTHROPIC_API_KEY=
# Optional — defaults to claude-haiku-4-5 (cheapest). A larger model gives
# better feedback at higher cost per call.
ANTHROPIC_MODEL=

# ── Optional: auto-feed sources (netlify/functions/fetch-jobs.js) ──
# Comma-separated board tokens, e.g. stripe,figma
GREENHOUSE_BOARDS=
LEVER_COMPANIES=
ASHBY_COMPANIES=
# developer.usajobs.gov
USAJOBS_KEY=
USAJOBS_EMAIL=
# developer.adzuna.com
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
